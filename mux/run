#!/usr/bin/env python3
import json
import sys

from harness.build import Build
from harness.comparators import impls
from harness.params import Params
from harness.race import Race
from harness.resolution import Resolution

params = Params.load()
resolution = Resolution(Build.resolved())
build = Build(resolution)
toolchains = Build.toolchains()
race = Race(params, {runtime: build.binary(runtime) for runtime in toolchains})
print(
    f"mux: {', '.join(i.name for i in race.impls)}; {params.repeat} repetitions; window {params.window} B",
    file=sys.stderr,
)
race.run()
rows = []
for impl in race.impls:
    if impl.name in impls:
        comparator = impls[impl.name]
        pick = resolution.picks["comparators"][comparator.name]
        tags = {
            "impl": impl.name,
            "package": comparator.package,
            "version": pick["version"],
            "mode": pick["mode"],
            "toolchain": toolchains[comparator.runtime],
        }
    else:
        tags = {"impl": impl.name, "package": "muxbench", "budget": str(params.budget)}
    rows.append({"name": "comparator", "tags": tags, "verdict": "ok"})
rows += race.rows()
print(json.dumps({"rows": rows}))

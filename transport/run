#!/bin/bash
set -euo pipefail
params=$BENCHER_IN/params.json
param() { jq -r --arg default "$2" "$1 // \$default" "$params"; }
duration=$(param .duration 10)
repeat=$(param .repeat 3)
export PDBD_BAUD
PDBD_BAUD=$(param .baud 115200)
linkup=$BENCHER_IN/artifacts/linkup
pppd=/opt/pppd/sbin/pppd
version=$(cat /opt/pppd/VERSION)
near=10.0.0.1
far=10.0.0.2
cpus=$(python3 -c 'import os; print(*sorted(os.sched_getaffinity(0)))')
work=$(mktemp -d)
mapfile -t pairings < <(jq -r '(.pairings // ["pppd.pppd", "linkup.linkup", "linkup.pppd"])[]' "$params")
if [ ! -x "$linkup" ]; then
  echo "transport: no linkup artifact, so only pairings without linkup run" >&2
  mapfile -t pairings < <(printf '%s\n' "${pairings[@]}" | grep -v linkup || true)
fi
echo "transport: pppd $version ($(cat /opt/pppd/MODE)), ${repeat}x per pairing, iperf3 ${duration}s per run, CPUs $cpus" >&2

busy() {
  awk -v cpus=" $cpus " -v t="$(date +%s.%N)" '
    $1 ~ /^cpu[0-9]+$/ && index(cpus, " " substr($1, 4) " ") { n += $2 + $3 + $4 + $7 + $8 + $9 }
    END { print t, n }' /proc/stat
}

start() {
  local side=$1 kind=$2 tty=$3 local=$4 peer=$5 unit=$6 log=$7
  local prefix=()
  [ "$side" = near ] && prefix=(ip netns exec near)
  case $kind in
    pppd) "${prefix[@]}" "$pppd" "$tty" "$PDBD_BAUD" noauth local nodetach nocrtscts novj noccp nolock debug \
            lcp-echo-interval 0 unit "$unit" logfile "$log" "$local:$peer" >/dev/null 2>&1 & ;;
    linkup) "${prefix[@]}" "$linkup" "$tty" "$local" "$peer" "pdbd$unit" 2>"$log" >/dev/null & ;;
  esac
}

opened() {
  case $1 in
    pppd) grep -q 'local  IP address' "$2" 2>/dev/null ;;
    linkup) grep -q 'phase: Open' "$2" 2>/dev/null ;;
  esac
}

attempt() {
  local nearkind=$1 farkind=$2 out=$3
  mkdir -p "$out"
  ip netns add near || return 1
  ip -n near link set lo up || return 1
  socat PTY,link="$work/a",raw,echo=0 PTY,link="$work/b",raw,echo=0 &
  for _ in $(seq 1 100); do [ -e "$work/a" ] && [ -e "$work/b" ] && break; sleep 0.05; done
  start far "$farkind" "$work/b" "$far" "$near" 0 "$out/far.log"
  case $farkind in pppd) dev=ppp0 ;; linkup) dev=pdbd0 ;; esac
  for _ in $(seq 1 200); do ip link show "$dev" >/dev/null 2>&1 && break; sleep 0.05; done # #24: a near ConfReq sent before the far tty opens is lost, and linkup never resends it
  local t0 a= b=
  t0=$(date +%s.%N)
  start near "$nearkind" "$work/a" "$near" "$far" 1 "$out/near.log"
  for _ in $(seq 1 3000); do
    [ -n "$a" ] || ! opened "$nearkind" "$out/near.log" || a=$(date +%s.%N)
    [ -n "$b" ] || ! opened "$farkind" "$out/far.log" || b=$(date +%s.%N)
    [ -n "$a" ] && [ -n "$b" ] && break
    sleep 0.01
  done
  if [ -z "$a" ] || [ -z "$b" ]; then
    echo "transport: $nearkind ↔ $farkind: L2 never opened (near ${a:-closed}, far ${b:-closed})" >&2
    return 1
  fi
  awk -v a="$a" -v b="$b" -v t="$t0" 'BEGIN { printf "%.1f\n", ((a > b ? a : b) - t) * 1000 }' > "$out/bringup"
  local up=
  for _ in $(seq 1 40); do ip netns exec near ping -c1 -W1 "$far" >/dev/null 2>&1 && up=1 && break; sleep 0.25; done
  [ -n "$up" ] || { echo "transport: $nearkind ↔ $farkind: L3 never answered after L2 opened" >&2; return 1; }

  iperf3 -s -B "$far" >/dev/null 2>&1 &
  local server=$!
  for _ in $(seq 1 50); do [ -n "$(ss -Hltn "src $far:5201")" ] && break; sleep 0.1; done
  ip netns exec near ping -c 20 -i 0.2 -W 5 "$far" > "$out/idle.ping" || return 1
  local before after
  before=$(busy)
  { sleep 2; ip netns exec near ping -c $(( (duration - 3) * 5 )) -i 0.2 -W 10 "$far" > "$out/loaded.ping"; } &
  local pinger=$!
  ip netns exec near iperf3 -c "$far" -t "$duration" -J > "$out/forward.json" || return 1
  wait "$pinger" || return 1
  ip netns exec near iperf3 -c "$far" -t "$duration" -J -R > "$out/reverse.json" || return 1
  ip netns exec near iperf3 -c "$far" -t "$duration" -J -P 4 > "$out/parallel.json" || return 1
  after=$(busy)
  kill "$server" 2>/dev/null || true
  local bytes
  bytes=$(jq -s 'map(.end.sum_received.bytes) | add' "$out/forward.json" "$out/reverse.json" "$out/parallel.json")
  awk -v b="$before" -v a="$after" -v bytes="$bytes" -v hz="$(getconf CLK_TCK)" \
    'BEGIN { split(b, x, " "); split(a, y, " "); printf "%.2f\n", (y[2] - x[2]) * 1000 / hz / (bytes / 1e6) }' > "$out/cpu"
}

down() {
  jobs -p | xargs -r kill 2>/dev/null || true
  wait 2>/dev/null || true
  ip netns del near 2>/dev/null || true
  rm -f "$work/a" "$work/b"
}

trap 'down; rm -rf "$work"' EXIT
for pairing in "${pairings[@]}"; do
  nearkind=${pairing%%.*}
  farkind=${pairing#*.}
  for i in $(seq 1 "$repeat"); do
    out="$work/$pairing/$i"
    (
      echo "$BASHPID" > "$BENCHER_REPORTERS/$pairing.pid"
      status=0
      attempt "$nearkind" "$farkind" "$out" || status=$?
      down
      exit "$status"
    ) && touch "$out/ok" || true
    sleep 1
  done
done

mbit() { jq -r '.end.sum_received.bits_per_second / 1e6' "$1"; }
rtt() { grep -o 'time=[0-9.]*' "$1" | cut -d= -f2; }
for pairing in "${pairings[@]}"; do
  dir="$work/$pairing"
  tags=$(jq -nc --arg p "$pairing" --arg v "$version" '{pairing: $p} + (if ($p | test("pppd")) then {pppd: $v} else {} end)')
  ok=$(find "$dir" -name ok | wc -l)
  verdict=$([ "$ok" -eq "$repeat" ] && echo ok || echo err)
  jq -nc --argjson t "$tags" --arg v "$verdict" '{name: "link", tags: $t, verdict: $v}'
  [ "$ok" -gt 0 ] || continue
  runs=$(for i in $(seq 1 "$repeat"); do [ -e "$dir/$i/ok" ] && echo "$dir/$i"; done)
  jq -nc --argjson t "$tags" --argjson s "$(for r in $runs; do cat "$r/bringup"; done | jq -sc .)" '{name: "bring-up", tags: $t, samples: {ms: $s}}'
  for direction in forward reverse parallel; do
    jq -nc --argjson t "$tags" --arg d "$direction" --argjson s "$(for r in $runs; do mbit "$r/$direction.json"; done | jq -sc .)" \
      '{name: "throughput", tags: ($t + {direction: $d}), samples: {"Mbit/s": $s}}'
  done
  for load in idle loaded; do
    jq -nc --argjson t "$tags" --arg l "$load" --argjson s "$(for r in $runs; do rtt "$r/$load.ping"; done | jq -sc .)" \
      '{name: "rtt", tags: ($t + {load: $l}), samples: {ms: $s}}'
  done
  jq -nc --argjson t "$tags" --arg p "$pairing" --argjson s "$(for r in $runs; do cat "$r/cpu"; done | jq -sc .)" \
    '{name: "cpu", tags: $t, reporter: $p, samples: {"ms/MB": $s}}'
done | jq -sc '{rows: .}'

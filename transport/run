#!/usr/bin/env python3
import json
import sys
import tempfile
from pathlib import Path

from harness import Cpus, Pairing, Params

params = Params.load()
cpus = Cpus()
pairings = params.runnable()
if pairings != params.pairings:
    print("transport: no linkup artifact, so only pairings without linkup run", file=sys.stderr)
print(
    f"transport: pppd {params.version} ({params.mode}), {params.repeat}x per pairing, "
    f"iperf3 {params.duration}s per run, CPUs {' '.join(map(str, cpus.ids))}",
    file=sys.stderr,
)
pppd = {"version": params.version, "mode": params.mode, "toolchain": params.toolchain}
rows = (
    [{"name": "pppd", "tags": pppd, "verdict": "ok"}] if any("pppd" in p for p in pairings) else []
)
with tempfile.TemporaryDirectory() as work:
    rows += [row for name in pairings for row in Pairing(name, params, cpus, Path(work)).rows()]
print(json.dumps({"rows": rows}))
